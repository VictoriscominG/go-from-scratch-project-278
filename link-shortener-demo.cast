[116.858758, "o", "\u001b[7m# 13. Короткое имя занято → 422 с сообщением\u001b[27m\r\n\r\u001b[7mcurl -s -X POST $BASE/api/links \\\u001b[27m\r\n\r\u001b[7m  -H \"Content-Type: application/json\" \\\u001b[27m\r\n\r\u001b[7m  -d '{\"original_url\": \"https://b.io\", \"short_name\": \"golang\"}' | jq\u001b[27m"]
