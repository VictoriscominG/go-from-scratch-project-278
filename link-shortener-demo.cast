[108.210333, "o", "\u001b[7m# 12. Невалидный URL → 422\u001b[27m\r\n\r\u001b[7mcurl -s -X POST $BASE/api/links \\\u001b[27m\r\n\r\u001b[7m  -H \"Content-Type: application/json\" \\\u001b[27m\r\n\r\u001b[7m  -d '{\"original_url\": \"not-a-url\"}' | jq\u001b[27m"]
[109.795801, "o", "\u001b[A\u001b[A\u001b[A\b# 12. Невалидный URL → 422\r\n\rcurl -s -X POST $BASE/api/links \\\r\n"]
